<domain type="kvm">
 <name>nextgen-win11</name>
 <description>Windows 11 Enterprise Evaluation. Isolated Nextgen installer and SDK QA on iMac; no host disk passthrough.</description>
 <memory unit="MiB">8192</memory><currentMemory unit="MiB">8192</currentMemory><vcpu placement="static">2</vcpu>
 <os><type arch="x86_64" machine="q35">hvm</type><loader readonly="yes" secure="yes" type="pflash">/usr/share/OVMF/OVMF_CODE_4M.ms.fd</loader><nvram template="/usr/share/OVMF/OVMF_VARS_4M.ms.fd">/var/lib/libvirt/qemu/nvram/nextgen-win11_VARS.fd</nvram><boot dev="cdrom"/><boot dev="hd"/><bootmenu enable="yes"/></os>
 <features><acpi/><apic/><smm state="on"/><hyperv mode="custom"><relaxed state="on"/><vapic state="on"/><spinlocks state="on" retries="8191"/></hyperv></features>
 <cpu mode="host-passthrough" check="none" migratable="off"/>
 <clock offset="localtime"><timer name="rtc" tickpolicy="catchup"/><timer name="pit" tickpolicy="delay"/><timer name="hpet" present="no"/><timer name="hypervclock" present="yes"/></clock>
 <on_poweroff>destroy</on_poweroff><on_reboot>restart</on_reboot><on_crash>destroy</on_crash>
 <devices><emulator>/usr/bin/qemu-system-x86_64</emulator>
  <disk type="file" device="disk"><driver name="qemu" type="qcow2"/><source file="/var/lib/libvirt/images/nextgen-windows/windows11.qcow2"/><target dev="sda" bus="sata"/></disk>
  <disk type="file" device="cdrom"><driver name="qemu" type="raw"/><source file="/var/lib/libvirt/images/nextgen-windows/Windows11-Enterprise-Evaluation-x64.iso"/><target dev="sdb" bus="sata"/><readonly/></disk>
  <disk type="file" device="cdrom"><driver name="qemu" type="raw"/><source file="/var/lib/libvirt/images/nextgen-windows/autounattend.iso"/><target dev="sdc" bus="sata"/><readonly/></disk>
  <controller type="usb" model="qemu-xhci"/><controller type="sata" index="0"/><controller type="virtio-serial" index="0"/>
  <interface type="network"><source network="default"/><model type="e1000e"/></interface>
  <channel type="unix"><target type="virtio" name="org.qemu.guest_agent.0"/></channel>
  <input type="tablet" bus="usb"/>
  <graphics type="spice" autoport="yes"><listen type="address" address="127.0.0.1"/></graphics>
  <video><model type="vga" vram="32768" heads="1" primary="yes"/></video>
  <tpm model="tpm-crb"><backend type="emulator" version="2.0"/></tpm>
  <memballoon model="virtio"/>
 </devices>
</domain>