{
  "template": {
    "version": 1,
    "title": "Order details",
    "parameters": {
      "company": {
        "type": "string",
        "default": "Example Company"
      }
    },
    "blocks": [
      {
        "type": "text",
        "text": "{{parameters.company}} · {{data.row.id}}",
        "style": {
          "size": 22,
          "bold": true
        }
      },
      {
        "type": "text",
        "text": "Customer: {{data.row.customer}}"
      },
      {
        "type": "table",
        "source": "row.lines",
        "padding": 5,
        "columns": [
          {
            "title": "Item",
            "field": "item",
            "weight": 3
          },
          {
            "title": "Qty",
            "field": "quantity",
            "align": "right"
          },
          {
            "title": "Total",
            "expression": "row.quantity * row.price",
            "format": "N2",
            "aggregate": "sum",
            "align": "right"
          }
        ],
        "drillDown": {
          "label": "Open line details",
          "template": {
            "version": 1,
            "title": "Line details",
            "blocks": [
              {
                "type": "text",
                "text": "{{data.row.item}}",
                "style": {
                  "size": 22,
                  "bold": true
                }
              },
              {
                "type": "text",
                "text": "Quantity: {{data.row.quantity}} · Unit price: {{data.row.price}}"
              },
              {
                "type": "text",
                "text": "Order: {{data.source.row.id}}"
              }
            ]
          }
        }
      }
    ]
  },
  "data": {
    "row": {
      "id": "ORD-002",
      "customer": "West branch",
      "amount": 225,
      "lines": [
        {
          "item": "Delivery service",
          "quantity": 2,
          "price": 100
        },
        {
          "item": "Packaging",
          "quantity": 1,
          "price": 25
        }
      ]
    },
    "source": {
      "orders": [
        {
