  "topics": {
    "overview": {
      "mode": "viewer",
      "title": "Create, preview and export a report",
      "description": "Choose a sample, turn its pages and download the generated report.",
      "sample": "sales"
    },
    "index": {
      "mode": "tour",
      "title": "Choose a reporting workflow",
      "description": "Open a working example for the task you want to explore.",
      "sample": "sales"
    },
    "agent-authoring": {
      "mode": "agent",
      "title": "From a template to a portable project",
      "description": "Inspect an actual template, inspect the engine result, and download a project to open in Studio.",
      "sample": "parameters-east-0"
    },
    "data-import": {
      "mode": "import",
      "title": "Import CSV, TSV or Excel",
      "description": "Import the included inventory fixture and inspect the typed rows returned by the engine.",
      "sample": "imported"
    },
    "data-preparation": {
      "mode": "prepare",
      "title": "Filter, calculate and group data",
      "description": "Choose a minimum amount and inspect input rows, derived tables and the generated regional report.",
      "sample": "prepared-10"
    },
    "data-sources": {
      "mode": "sources",
      "title": "JSON, SQLite and object data",
      "description": "Inspect the same inventory dataset in three source forms, including a runnable SQLite database.",
      "sample": "imported"
    },
    "desktop": {
      "mode": "desktop",
      "title": "Open a report in desktop Studio",
      "description": "Choose your platform and download the example project for the installed application.",
      "sample": "sales"
    },
    "developer-guide": {
      "mode": "api",
      "title": "Request → engine response → report",
      "description": "Inspect the actual request and response for a report; download the portable project and output.",
      "sample": "sales"
    },
    "dotnet-integration": {
      "mode": "dotnet",
      "title": "A paginated .NET / Blazor report",
      "description": "Inspect the .NET request contract and use the viewer controls with a generated document.",
      "sample": "sales"
    },
    "drill-down": {
      "mode": "drill",
      "title": "Open an order detail report",
      "description": "Choose an order to render its actual nested detail report, then return to the summary.",
      "sample": "orders"
    },
    "flutter-integration": {
      "mode": "flutter",
      "title": "A report for the Flutter client",
      "description": "Inspect the request/response contract and preview the same document consumed by the Flutter SDK.",
      "sample": "charts"
    },
    "http-connections": {
      "mode": "http",
      "title": "Refresh a JSON source snapshot",
      "description": "Compare the two included HTTP-response fixtures and their independently rendered reports.",
      "sample": "http-1"
    },
    "image-export": {
      "mode": "images",
      "title": "Export report pages as PNG or SVG",
      "description": "Choose format, page range and PNG resolution, then download the engine-generated image archive.",
      "sample": "sales"
    },
    "office-export": {
      "mode": "office",
      "title": "Export to Excel and Word",
      "description": "Choose format, editable text or page images, and an inclusive page range. Download is a real Office document.",
      "sample": "sales"
    },
    "report-authoring-manual": {
      "mode": "parameters",
      "title": "Generate a report from parameters",
      "description": "Change the region and minimum quantity. Each combination has a matching engine-generated report and project.",
      "sample": "parameters-east-0"
    },
    "report-library": {
      "mode": "library",
      "title": "Save and restore report versions",
      "description": "Keep sample project versions in this browser, restore one and download its matching project.",
      "sample": "sales"
    },
    "report-logic-manual": {
      "mode": "logic",
      "title": "Run report lifecycle examples",
      "description": "Choose a minimum quantity to inspect actual TypeScript results, or trigger the validation-error example.",
      "sample": "logic-0"
    },
    "template-format": {
      "mode": "template",
      "title": "Inspect and validate a template",
      "description": "Compare a valid template with an invalid block type and inspect diagnostics returned by the engine.",
      "sample": "parameters-east-0"
    },
    "toolbox": {
      "mode": "toolbox",
      "title": "A parameter dialog in action",
      "description": "Use the region selector and quantity control to generate the matching report.",
      "sample": "parameters-east-0"
    },
    "installation": {
      "mode": "installation",
      "title": "Install and open your first project",
      "description": "Choose Linux, macOS or Windows, follow the launch steps, and open the included example project.",
      "sample": "sales"
    }
  },
